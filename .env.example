# ── Obrigatórias (Supabase → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Nunca coloque a service_role aqui nem no client: o app usa só a anon key + RLS.

# ── Opcionais, só no servidor (Vercel → Settings → Environment Variables) ──
# IA do tutor de estudos, do cardápio e do assistente financeiro. Sem elas, o app usa planos de reserva.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Integração com Google Agenda.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Busca de capas e dados de livros (opcional).
GOOGLE_BOOKS_API_KEY=
# Ajustes finos de IA (opcional): "claude" ou "gemini" e modelos específicos.
AI_PROVIDER=
AI_CLAUDE_MODEL=
AI_CLAUDE_FAST_MODEL=
GEMINI_MODEL=
